
<!DOCTYPE html>
<html lang="tr">
<head>
<meta name="google-site-verification" content="s9Hl0LNykR-mr_YeuhIA1BdKFMZuJyaH9bTa-aNYvHw" />
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Mavi Rota Yachting - Lüks yat kiralama, özel tekne turları ve denizde ayrıcalıklı tatil.">
<title>Mavi Rota Yachting | Luxury Yacht Experience</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
:root {
  --navy: #071c2c;
  --gold: #c5a46d;
  --white: #fff;
  --light: #f5f4f0;
  --text: #263746;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  scroll-behavior: smooth;
}

body {
  font-family: 'DM Sans', sans-serif;
  color: var(--text);
}

a { text-decoration: none; color: inherit; }

.container {
  width: 88%;
  max-width: 1250px;
  margin: auto;
}

header {
  position: absolute;
  width: 100%;
  top: 0;
  z-index: 10;
  padding: 27px 0;
  border-bottom: 1px solid #ffffff30;
}

nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: white;
}

.logo {
  font-family: 'Playfair Display', serif;
  font-size: 27px;
  letter-spacing: 2px;
}

.logo span { color: var(--gold); }

.nav-links {
  display: flex;
  gap: 32px;
  align-items: center;
  font-size: 13px;
  letter-spacing: 1px;
}

.nav-links a:hover { color: var(--gold); }

.nav-button {
  border: 1px solid var(--gold);
  padding: 12px 22px;
  color: white;
}

.hero {
  height: 100vh;
  min-height: 650px;
  display: flex;
  align-items: center;
  background:
    linear-gradient(90deg, #061b2bd9, #061b2b50),
    url('https://images.unsplash.com/photo-1567899378494-47b22a2ae96a?auto=format&fit=crop&w=2200&q=85')
    center/cover;
  color: white;
}

.hero-content { max-width: 720px; }

.eyebrow {
  color: var(--gold);
  letter-spacing: 4px;
  font-size: 12px;
  margin-bottom: 25px;
  text-transform: uppercase;
}

.hero h1 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(44px, 7vw, 83px);
  line-height: 1.12;
  font-weight: 400;
  margin-bottom: 25px;
}

.hero p {
  color: #e1e6e9;
  font-size: 16px;
  line-height: 1.9;
  max-width: 560px;
  margin-bottom: 35px;
}

.btn {
  display: inline-block;
  background: var(--gold);
  color: var(--navy);
  padding: 16px 30px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1px;
  transition: .3s;
}

.btn:hover {
  background: white;
  transform: translateY(-3px);
}

.section { padding: 105px 0; }

.section-title {
  text-align: center;
  margin-bottom: 55px;
}

.section-title small {
  color: var(--gold);
  letter-spacing: 3px;
  font-size: 11px;
}

.section-title h2 {
  font-family: 'Playfair Display', serif;
  font-size: 43px;
  font-weight: 400;
  color: var(--navy);
  margin-top: 15px;
}

.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 70px;
  align-items: center;
}

.about-image img {
  width: 100%;
  height: 510px;
  object-fit: cover;
}

.about-text h2 {
  font-family: 'Playfair Display', serif;
  font-size: 43px;
  font-weight: 400;
  color: var(--navy);
  margin: 15px 0 25px;
}

.about-text p {
  line-height: 2;
  font-size: 14px;
  color: #64717b;
  margin-bottom: 20px;
}

.services {
  background: var(--navy);
  color: white;
}

.services .section-title h2 { color: white; }

.service-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
}

.service-card {
  border: 1px solid #ffffff25;
  padding: 40px 30px;
  transition: .3s;
}

.service-card:hover {
  border-color: var(--gold);
  transform: translateY(-5px);
}

.service-icon {
  color: var(--gold);
  font-size: 32px;
  margin-bottom: 25px;
}

.service-card h3 {
  font-family: 'Playfair Display', serif;
  font-size: 25px;
  margin-bottom: 15px;
}

.service-card p {
  color: #aebcc6;
  font-size: 13px;
  line-height: 1.9;
}

.yacht-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
}

.yacht-card {
  background: white;
  box-shadow: 0 8px 35px #0000000c;
}

.yacht-card img {
  width: 100%;
  height: 250px;
  object-fit: cover;
  display: block;
}

.yacht-info { padding: 25px; }

.yacht-info h3 {
  font-family: 'Playfair Display', serif;
  font-size: 25px;
  color: var(--navy);
  margin-bottom: 10px;
}

.yacht-info p {
  color: #84909a;
  font-size: 13px;
  margin-bottom: 20px;
}

.yacht-info a {
  color: var(--gold);
  font-size: 12px;
  font-weight: bold;
  letter-spacing: 1px;
}

.gallery {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}

.gallery img {
  width: 100%;
  height: 290px;
  object-fit: cover;
  transition: .4s;
}

.gallery img:hover { opacity: .8; }

.banner {
  padding: 115px 20px;
  text-align: center;
  color: white;
  background:
    linear-gradient(#071c2cb8,#071c2cb8),
    url('https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=2000&q=85')
    center/cover fixed;
}

.banner h2 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(35px, 5vw, 55px);
  font-weight: 400;
  margin-bottom: 25px;
}

.banner p {
  color: #e1e6e9;
  margin-bottom: 35px;
}

.contact {
  background: var(--light);
}

.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
}

.contact h2 {
  font-family: 'Playfair Display', serif;
  font-size: 40px;
  color: var(--navy);
  margin-bottom: 20px;
}

.contact p {
  line-height: 2;
  color: #687783;
  margin-bottom: 15px;
}

.contact-form input,
.contact-form textarea {
  width: 100%;
  padding: 16px;
  margin-bottom: 15px;
  border: 1px solid #ddd;
  background: white;
  font-family: inherit;
  outline: none;
}

.contact-form textarea { height: 130px; resize: vertical; }

.contact-form button {
  border: none;
  cursor: pointer;
}

footer {
  background: #041421;
  color: white;
  padding: 35px 0;
  text-align: center;
  font-size: 12px;
}

footer span { color: var(--gold); }

@media(max-width: 800px) {
  .nav-links { display: none; }
  .hero { min-height: 650px; }
  .about-grid, .contact-grid { grid-template-columns: 1fr; }
  .service-grid, .yacht-grid { grid-template-columns: 1fr; }
  .gallery { grid-template-columns: 1fr 1fr; }
  .about-image img { height: 350px; }
  .section { padding: 75px 0; }
  .section-title h2 { font-size: 34px; }
}

@media(max-width: 480px) {
  .gallery { grid-template-columns: 1fr; }
  .gallery img { height: 250px; }
}
</style>
</head>

<body>

<header>
  <nav class="container">
    <a class="logo" href="#">MAVİ ROTA<span>.</span></a>
    <div class="nav-links">
      <a href="#home">ANA SAYFA</a>
