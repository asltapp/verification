          <p>Özel Rotalar • VIP Hizmet</p>
          <a href="#contact">DETAYLI BİLGİ →</a>
        </div>
      </div>
      <div class="yacht-card">
        <img src="https://images.unsplash.com/photo-1504851149312-7a075b496cc7?auto=format&fit=crop&w=900&q=85" alt="Yelkenli yat">
        <div class="yacht-info">
          <h3>Sailing Experience</h3>
          <p>Doğa • Macera • Deniz</p>
          <a href="#contact">DETAYLI BİLGİ →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="banner">
  <div class="container">
    <div class="eyebrow">YOUR PRIVATE ESCAPE</div>
    <h2>Bir Rota Seçin,<br>Gerisini Bize Bırakın.</h2>
