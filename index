  <div class="container">
    <div class="section-title">
      <small>DENİZDEN KARELER</small>
      <h2>Yaşamdan Daha Fazlası</h2>
    </div>
    <div class="gallery">
      <img src="https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=700&q=85" alt="Mavi deniz">
